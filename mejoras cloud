  env.DB.prepare(`SELECT COALESCE(SUM(total),0) AS total FROM expenses WHERE type='Prestamo' AND status='pending'${yearFilter ? ' AND' + yearFilter.slice(6) : ''}`).first(),
  env.DB.prepare(`SELECT COUNT(*) AS count FROM expenses WHERE status='unconfirmed'${yearFilter ? ' AND' + yearFilter.slice(6) : ''}`).first(),
]);
return json({
