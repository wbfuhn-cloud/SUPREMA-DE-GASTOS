# ====================================================
# CONFIGURACIÓN DEL ASISTENTE FINANCIERO
# ====================================================
# Copia este archivo como '.env' y rellena con tus valores reales.
# NUNCA subas el archivo .env real a Git.

# 1. Bot de Telegram — obtén este token de @BotFather en Telegram
TELEGRAM_BOT_TOKEN=TU_TOKEN_AQUI

# 2. Chat ID destino para alertas (usa @userinfobot en Telegram)
TELEGRAM_CHAT_ID=

# 3. Google Gemini API Key — obtén en https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=TU_API_KEY_AQUI

# ── Configuración Opcional ──────────────────────────
EXCEL_FILENAME=C:\ruta\a\tu\archivo.xlsx
DASHBOARD_URL=http://localhost:5050/dashboard

# Actualizaciones automáticas al iniciar (GitHub Releases)
# Ejemplo: APP_UPDATE_REPOSITORY=tu_usuario/SUPREMA-DE-GASTOS
APP_UPDATE_REPOSITORY=
APP_UPDATE_ENABLED=1

# Ngrok Auth Token (para acceso público sin VPN)
NGROK_AUTH_TOKEN=

# ── Lector de Correos BAZ Digital ───────────────────
EMAIL_ADDRESS=tu_correo@hotmail.com
EMAIL_PASSWORD=tu_app_password_aqui
EMAIL_IMAP_SERVER=imap.outlook.com
EMAIL_IMAP_PORT=993
EMAIL_CHECK_INTERVAL=5
EMAIL_SENDER_FILTER=notificaciones@bazdigital.com

# ── Cloudflare D1 (Base de Datos en la Nube) ────────
# Obtén estos datos creando una base de datos D1 en el panel de Cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=
# Autoescaneo: el programador permanece activo siempre, pero sólo escanea
# durante sesiones NYSE válidas para evitar datos vencidos y duplicados.
ENABLE_BOLSA_BACKGROUND_TASKS=1
ENABLE_BOLSA_AUTO_SCAN=1
BOLSA_AUTO_SCAN_INTERVAL_MINUTES=60
